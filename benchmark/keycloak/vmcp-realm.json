{
  "realm": "vmcp",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "vmcp-admins"
    },
    {
      "name": "vmcp-editors"
    },
    {
      "name": "vmcp-viewers"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "groups": [
        "/vmcp-admins"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Editor",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "groups": [
        "/vmcp-editors"
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.test",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "carol",
          "temporary": false
        }
      ],
      "groups": [
        "/vmcp-viewers"
      ]
    },
    {
      "username": "dave",
      "enabled": true,
      "email": "dave@example.test",
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Nogroup",
      "credentials": [
        {
          "type": "password",
          "value": "dave",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "vmcp",
      "name": "vMCP control plane",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "vmcp-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3300/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3300/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "billing-bot",
      "name": "Example agent (client_credentials)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "billing-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "profile",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "vmcp-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "vmcp-gateway",
      "name": "vMCP gateway as an OAuth client of upstreams",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "gateway-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "profile",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "fixture-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "fixture",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
