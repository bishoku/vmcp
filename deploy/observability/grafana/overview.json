  "panels": [
    {
      "type": "row",
      "title": "Geçit · API ve MCP trafiği",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "İstek hızı",
      "description": "Tamamlanan API ve MCP HTTP istekleri. Probe ve other hariç.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(vmcp_http_duration_seconds_count{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\",route=~\"api|mcp\"}[$__rate_interval]))",
          "legendFormat": "İstek hızı",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP hata oranı",
      "description": "HTTP 400 ve üzeri yanıtlar / tamamlanan istekler. Trafik yokken oran tanımsızdır.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum(rate(vmcp_http_errors_total{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\",route=~\"api|mcp\"}[$__rate_interval])) / sum(rate(vmcp_http_duration_seconds_count{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\",route=~\"api|mcp\"}[$__rate_interval]))",
          "legendFormat": "HTTP hata oranı",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HTTP gecikmesi · p95",
      "description": "Birleştirilmiş histogram. SSE bağlantı süresi bu ölçüme dahildir.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vmcp_http_duration_seconds_bucket{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\",route=~\"api|mcp\"}[$__rate_interval])))",
          "legendFormat": "HTTP gecikmesi · p95",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ]
    },
