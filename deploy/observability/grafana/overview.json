{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "vMCP metriklerini içeren Prometheus veri kaynağı",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "vmcp-fleet-overview",
  "title": "vMCP · Genel durum",
  "description": "API ve MCP trafiği, bağımlılık baskısı ve MCP iş yükü. Serilere tıklayarak ilgili servise veya operasyona geçin.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "tags": [
    "vmcp",
    "operations"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "job",
        "label": "Servis / job",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\"}, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\",job=~\"$job\"}, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\",job=~\"$job\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\",job=~\"$job\",namespace=~\"$namespace\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\",job=~\"$job\",namespace=~\"$namespace\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*"
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "vMCP · Servis ve bağımlılıklar",
      "url": "/d/vmcp-service-detail/vmcp-c2b7-servis-ve-bagimliliklar",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
