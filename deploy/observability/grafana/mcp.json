{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "vMCP metriklerini içeren Prometheus veri kaynağı",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
