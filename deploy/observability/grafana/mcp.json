    {
      "id": 2,
      "type": "stat",
      "title": "İstek hızı",
      "description": "Sanal sunucuya gelen HTTP istekleri. Yalnızca sanal sunucu filtresi uygulanır.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(vmcp_virtual_requests_total{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\",virtual_server=~\"$virtual_server\"}[$__rate_interval]))",
          "legendFormat": "İstek hızı",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ]
    },
