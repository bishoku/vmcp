          "query": "label_values(vmcp_upstream_requests_active{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\",upstream=~\"$upstream\",method=~\"$method\"}, tool)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(vmcp_upstream_requests_active{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\",upstream=~\"$upstream\",method=~\"$method\"}, tool)",
        "refresh": 2,
