  ],
  "uid": "vmcp-operation-detail",
  "title": "vMCP · MCP operasyonları",
  "description": "Sanal sunucu ve yayımlanan tool filtreleri istemci tarafını, upstream, metot ve orijinal tool filtreleri upstream denemelerini süzer. Alias nedeniyle iki tool ismi farklı olabilir.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "tags": [
    "vmcp",
    "operations"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "job",
        "label": "Servis / job",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\"}, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\",job=~\"$job\"}, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\",job=~\"$job\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\",job=~\"$job\",namespace=~\"$namespace\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({__name__=~\"vmcp_operation_label_overflows_total|vmcp_audit_export_metrics_available\",job=~\"$job\",namespace=~\"$namespace\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "type": "query",
        "name": "virtual_server",
        "label": "Sanal sunucu",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vmcp_virtual_requests_active{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\"}, virtual_server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(vmcp_virtual_requests_active{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\"}, virtual_server)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "type": "query",
        "name": "virtual_tool",
        "label": "Yayımlanan tool",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(vmcp_virtual_tool_calls_active{job=~\"$job\",namespace=~\"$namespace\",instance=~\"$instance\",virtual_server=~\"$virtual_server\"}, tool)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
